{
  "name": "meeti-no-ryokan",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "python3 serve.py",
    "build": "rm -rf dist && mkdir -p dist && cp -R public/. dist/",
    "build:dev": "rm -rf dist && mkdir -p dist && cp -R public/. dist/",
    "start": "python3 serve.py",
    "format": "prettier --write \"public/**/*.{html,css,js,json}\"",
    "format:check": "prettier --check \"public/**/*.{html,css,js,json}\"",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "wrangler": "^4.114.0"
  }
}
